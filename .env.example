# Environment Configuration
ENVIRONMENT=development

# Database Settings
# For local SQLite development (default):
DATABASE_URL=sqlite:///./job_tracker.db
# For local PostgreSQL development (e.g., via Docker Compose):
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/job_tracker

# Security & JWT Tokens
SECRET_KEY=replace_this_with_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma-separated or wildcard)
BACKEND_CORS_ORIGINS=["*"]
